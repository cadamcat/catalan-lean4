[
  "runuser",
  "-u",
  "verifier",
  "--",
  "env",
  "XDG_RUNTIME_DIR=/run/user/2000",
  "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/2000/bus",
  "PATH=/opt/lean-4.33.1/bin:/opt/catalan-checkers:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
  "systemd-run",
  "--user",
  "--unit=catalan-strict-comparator",
  "--pty",
  "--wait",
  "--property=RestrictAddressFamilies=~AF_UNIX",
  "--property=NoNewPrivileges=yes",
  "--property=MemoryMax=48G",
  "--property=RuntimeMaxSec=7200",
  "-E",
  "PATH=/opt/lean-4.33.1/bin:/opt/catalan-checkers:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
  "--working-directory=/srv/catalan-proof",
  "--",
  "bash",
  "-c",
  "lake env /opt/catalan-checkers/comparator /srv/catalan-audit/audit/config.json"
]
