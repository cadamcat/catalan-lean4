              (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))) →
          @Eq.{1} Nat n (@OfNat.ofNat.{0} Nat (nat_lit 8) (instOfNatNat (nat_lit 8))))
  (@And.intro (Catalan.JSP.IsProperPerfectPower (@OfNat.ofNat.{0} Nat (nat_lit 8) (instOfNatNat (nat_lit 8))))
    (Catalan.JSP.IsProperPerfectPower (@OfNat.ofNat.{0} Nat (nat_lit 9) (instOfNatNat (nat_lit 9))))
    Catalan.JSP.eight_isProperPerfectPower Catalan.JSP.nine_isProperPerfectPower)
