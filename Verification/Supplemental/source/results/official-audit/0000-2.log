theorem Catalan.JSP.statement : Catalan.JSP.Statement :=
@And.intro
  (And (Catalan.JSP.IsProperPerfectPower (@OfNat.ofNat.{0} Nat (nat_lit 8) (instOfNatNat (nat_lit 8))))
    (Catalan.JSP.IsProperPerfectPower (@OfNat.ofNat.{0} Nat (nat_lit 9) (instOfNatNat (nat_lit 9)))))
  (∀ (n : Nat),
    @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) n →
